root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
# Compose-style code reads better with wide lines; formatting is otherwise enforced by ktlint.
max_line_length = off
# @Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Wildcard imports are not used; keep ktlint's default ordering.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{xml,json,md,yml,toml,properties}]
indent_size = 2
