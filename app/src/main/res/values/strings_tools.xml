    <!-- Privacy -->
    <string name="privacy_title">Privacy &amp; about</string>
    <string name="privacy_version">Version %1$s</string>
    <string name="privacy_summary">AquaGrow works fully offline. There is no account, no ads and no analytics or tracking.</string>
    <string name="privacy_data_title">Your data stays on this phone</string>
    <string name="privacy_data_body">Plants, tanks, fish, logs, tasks, photos, inventory and expenses are stored only in the app\'s private storage. Nothing is uploaded unless you choose to.</string>
    <string name="privacy_backup_title">Backups are files you control</string>
    <string name="privacy_backup_body">A backup is written only to the place you pick in the system file picker. AquaGrow cannot read other files on your phone.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">Camera: only when you take a plant or fish photo. Notifications: for the care reminders you set up. Run at startup: to restore reminders after the phone restarts.</string>
    <string name="privacy_ai_title">Optional assistant</string>
    <string name="privacy_ai_body">The assistant is off by default. If you turn it on, only the question you type, and any plant, tank or photo you choose to attach, is sent to the assistant server. You can turn it off at any time.</string>
    <string name="privacy_estimates_title">About the advice</string>
    <string name="privacy_estimates_body">Harvest dates, growth stages and care tips are general estimates. Water test alerts compare readings with ranges; they do not diagnose fish illness. When in doubt, ask a local expert or vet.</string>
    <string name="privacy_delete_title">Deleting your data</string>
    <string name="privacy_delete_body">Uninstalling AquaGrow, or clearing its storage in system settings, deletes all data from this phone. Backup files you saved elsewhere are not touched.</string>
    <string name="privacy_licenses_title">Open-source</string>
    <string name="privacy_licenses_body">Fonts Outfit and DM Sans (SIL Open Font License). Material Symbols (Apache 2.0). Built with Android Jetpack libraries (Apache 2.0).</string>
