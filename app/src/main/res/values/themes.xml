<resources>
    <!-- Window theme only; all in-app styling is done by the Compose theme. -->
    <style name="Theme.AquaGrow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_background</item>
    </style>

    <!-- Launch theme: icon B on beige, then switches to Theme.AquaGrow. -->
    <style name="Theme.AquaGrow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AquaGrow</item>
    </style>

    <style name="Theme.AquaGrow.Translucent" parent="android:Theme.Translucent.NoTitleBar" />
</resources>
